# Binary assets via Git LFS (tech_guidelines.md D14). Nothing matches yet in
# Pass 1 (no art/audio has landed), but the policy is declared up front so the
# first asset commit is never an accidental full-blob commit.
*.png filter=lfs diff=lfs merge=lfs -text
*.ogg filter=lfs diff=lfs merge=lfs -text
*.wav filter=lfs diff=lfs merge=lfs -text
*.ttf filter=lfs diff=lfs merge=lfs -text
*.otf filter=lfs diff=lfs merge=lfs -text
*.aseprite filter=lfs diff=lfs merge=lfs -text

# Everything else — code, content, docs — stays plain text and diffs normally.
*.gd text
*.gdshader text
*.md text
*.json text
*.cfg text
*.godot text
