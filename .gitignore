# Godot 4 editor artifacts — never commit these (tech_guidelines.md §10).
.godot/
.import/
export.cfg
*.translation

# export_presets.cfg IS committed (tracked below in build/ builds, this file
# itself is not build output): it holds no secrets, only preset definitions,
# and CI's export-web.yml workflow needs it to know the Web preset exists at
# all. Only .godot/export_credentials.cfg (already covered by .godot/ above)
# is the actually-sensitive half of Godot's export config split.
build/

# Editor/OS cruft
.DS_Store
Thumbs.db

# Python bytecode cache (tools/*.py are run directly via python3, never installed)
__pycache__/
*.pyc

# Local override files that must never carry secrets or machine-specific state
*.local
.env
